# Required
ELEVENLABS_API_KEY=sk_...

# Dubbing
ELEVENLABS_SOURCE_LANG=en
ELEVENLABS_TARGET_LANG=es
ELEVENLABS_POLL_INTERVAL_SEC=10
ELEVENLABS_POLL_TIMEOUT_MIN=120

# Audio extraction
EXTRACT_SAMPLE_RATE=16000
EXTRACT_CHANNELS=1
EXTRACT_BITRATE=32k

# Captions
CAPTION_MODE=karaoke
CAPTION_CHUNK_MAX_WORDS=3
CAPTION_FONT=Poppins-Bold.ttf
CAPTION_FONT_SCALE=0.045
CAPTION_MARGIN_FRACTION=0.10

# Video encoding
X264_CRF=17
X264_PRESET=medium
